# ============================================================================
# Solana STANDBY/BACKUP Node Failover v0.6.9 (LOCAL-first, 3-Tier RPC)
#
# Normal cycle: 100% LOCAL RPC. T2/T3 only for confirmation on trigger.
# Edit all values below before first run.
# After changes: systemctl restart solana-failover-standby
#
# SECURITY: once filled this file holds secrets (TG_BOT_TOKEN, the paid-RPC key
# inside TIER2_RPC, WEBHOOK_URL). The deploy script chmod 600's it. Never commit a
# filled copy to git — the repo ships only this placeholder template.
# ============================================================================

# --- Node identity ---
NODE_NAME="MY_VALIDATOR-STANDBY"          # shown in Telegram/ntfy alerts
VALIDATOR_TYPE="agave"                    # "agave" or "frankendancer"

# --- Keypair paths ---
# STAKED  = shared identity (we TAKE it when PRIMARY drops it)
# UNSTAKED = this node's own identity (MUST be unique per node!)
STAKED_KEYPAIR="/root/solana/mainnet-validator-keypair.json"
UNSTAKED_KEYPAIR="/root/solana/unstaked-standby.json"
SOLANA_PATH="$HOME/.local/share/solana/install/active_release/bin"
LEDGER_PATH=""                            # empty = auto-detect from running validator / systemd
VALIDATOR_SERVICE="solana"                # systemd unit name (only used as ledger auto-detect fallback)

# --- Three-Tier RPC ---
LOCAL_RPC="http://127.0.0.1:8899"                                             # LOCAL: health + delinquency (every cycle, free)
TIER2_RPC="https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE"             # Tier 2: confirm only on trigger (saves CU)
TIER3_RPC="https://api.mainnet-beta.solana.com"                                # Tier 3: fallback confirm + gossip

# --- Monitoring ---
# Get vote pubkey: solana-keygen pubkey /root/solana/vote-account-keypair.json
VOTE_PUBKEY=""                            # REQUIRED for STANDBY

# --- Thresholds ---
CHECK_INTERVAL=5                          # seconds between checks (normal mode)
TURBO_INTERVAL=1                          # seconds between checks (turbo: when delinquency detected)
DELINQUENCY_RETRIES=5                     # legacy; delinquency uses sliding window (7/10 default)
TAKEOVER_DELAY=60                         # seconds of sustained delinquency before acting

# Tier 1: skip takeover if our node is too far behind
LOCAL_HEALTH_MAX_BEHIND=100               # slots behind = unhealthy, don't take identity

# --- Sliding window (DDoS protection) ---
DELINQUENCY_WINDOW_SIZE=10                # last N checks to consider
DELINQUENCY_WINDOW_THRESHOLD=7            # how many must be delinquent to trigger
MAX_DELINQUENT_SLOTS=0                    # 0=wait for RPC delinquent list; 15=fast detect (v0.6.6 deploy preset)
HEARTBEAT_INTERVAL=600                    # status log every N seconds (600 = 10 min)

# --- Safety ---
DRY_RUN=true
GOSSIP_VERIFY=true                        # verify via gossip that the holder dropped the identity
GIVE_BACK_MODE="manual"                   # "manual" = hold after takeover (the ONLY implemented mode; v0.6.9 M6: "auto" is coerced to manual with a warning)

# --- STANDBY self-fence for the PROMOTED holder (v0.6.9 H1 — the PRIMARY self-fence, ported) ---
# After a takeover this node HOLDS and VOTES the staked identity and inherits the PRIMARY's residual:
# a partitioned-but-voting promoted STANDBY + a BACKUP at 120s is the documented SPLIT-BRAIN-RESIDUAL
# scenario. While STAKED, the daemon watches LOCAL signals ONLY (an external-RPC outage never demotes)
# and gives the identity back to this node's OWN unstaked key during the partition — before a heal can
# double-sign. Signals + knob names + defaults match the PRIMARY's failover.env block: frozen confirmed
# slot / continuously-silent LOCAL RPC (baseline-armed) / N6 own-vote-lag vs same-payload cluster-max
# (with the B2 flap hysteresis) / optional getHealth. Demote = authorized-voter remove-all +
# set-identity <own unstaked>, bounded (SETIDENTITY_TIMEOUT) with the B1 hard-stop escalation.
# Fail-safe: it can only ever lead to give-back (the safe direction). Do NOT raise the *_SECS values
# without raising the BACKUP's EXPECTED/TAKEOVER_DELAY in lock-step (same cross-node rule as the
# PRIMARY→STANDBY hop).
STANDBY_SELF_FENCE=true                   # master kill switch (false = pre-v0.6.9 "hold unfenced")
SELF_FENCE_ISOLATION_SECS=30              # LOCAL getSlot(confirmed) must advance within this window
SELF_FENCE_MAX_BEHIND=150                 # optional LOCAL getHealth "behind by >N" demote (0 = off)
SELF_FENCE_NOANSWER_SECS=30               # continuous LOCAL no-answer while staked (baseline-armed; 0 = off)
SELF_FENCE_VOTE_LAG_SLOTS=32              # N6 egress fence: own-vote lag past same-payload cluster-max (0 = off)
SELF_FENCE_VOTE_LAG_SECS=20               # N6: sustained seconds over threshold before demoting (0 = off)
SELF_FENCE_VOTE_LAG_RESET_CYCLES=3        # B2 flap hysteresis: consecutive healthy cycles to clear the timer (>= 2)
# v0.6.9 (H4): bound every take/give-back admin-socket call (same socket get_local_identity wraps in
# `timeout 8`). A wedged socket at the takeover instant used to freeze the loop mid-take. >= 8.
SETIDENTITY_TIMEOUT=15
# v0.6.9 (H1/B1): when a give-back (holder demote) wedges and the identity did not flip, hard-stop the
# validator (systemctl stop → mask --runtime → SIGTERM → SIGKILL; verified + re-verified) so the staked
# identity provably stops voting. false = alert only (NOT recommended). Never in DRY_RUN; NEVER on the
# take path (a spare's failed take is availability loss, never a kill).
SELF_FENCE_HARD_STOP=true
# v0.6.9 (H2): re-verify the hard-stop after this many seconds (>= the validator unit's RestartSec) —
# catches a Restart=always resurrect. Recovery after a masked hard-stop: systemctl unmask --runtime solana.
HARD_STOP_REVERIFY_SECS=15
# v0.6.9 (H1.3, safety-critical): post-self-fence RE-TAKE LOCKOUT. After a self-fence demote the staked
# vote account WILL look delinquent+frozen (WE were the voter and we stopped) — every normal takeover
# gate would pass and this node would take the identity right back. attempt_takeover refuses until this
# cooldown elapses AND all normal gates (external confirm + vote-liveness) pass fresh. Persisted across
# monitor restarts. 0 disables the lockout (NOT recommended).
SELF_FENCE_RETAKE_COOLDOWN=600

# --- Collision detector (v0.6.9 M5) ---
# While STAKED, every COLLISION_CHECK_INTERVAL seconds compare where external gossip (T2/T3) says the
# staked pubkey lives against our OWN endpoint (LOCAL view). Two consecutive mismatches → 🚨 page
# "STAKED IDENTITY SEEN ELSEWHERE (possible collision)" (throttled). DETECTION-ONLY — never demotes.
COLLISION_CHECK_INTERVAL=60

# --- State persistence (v0.6.9 H3/M10) ---
# Role-specific state file (.../state-standby; the legacy .../state migrates once). The promoted-holder
# self-fence baseline + the re-take lockout are persisted every cycle; the baseline is restored after a
# monitor restart only when fresher than STATE_MAX_AGE_SECS and only with first-read evidence the stall
# is continuous. The re-take lockout is restored unconditionally (restoring can only BLOCK a take).
STATE_MAX_AGE_SECS=900
# If the persisted state says this node was STAKED (promoted holder) and the local validator is
# unreachable this long at monitor startup → 🚨 STANDBY UNREACHABLE WHILE STAKED (once).
STARTUP_STAKED_UNREACHABLE_ALERT_SECS=60

# v0.6.2 (C1/C2) / v0.6.3 (Block 1): vote-liveness fence — the AUTHORITATIVE split-brain check.
# Before taking, confirm the staked vote account is NOT advancing (nobody is voting it).
# Topology-independent; all roles use it. v0.6.3 makes it the single authoritative gate (gossip is
# advisory only — a staked pubkey lingers ~48h in gossip, so a stale entry must not block takeover).
VOTE_LIVENESS_VERIFY=true                 # REQUIRED — leave ON (see ALLOW_UNFENCED_TAKEOVER below)
VOTE_LIVENESS_EPSILON=2                   # lastVote must advance > N slots between samples to count as "voting"
VOTE_LIVENESS_MIN_INTERVAL=10             # min seconds between the two lastVote samples
# v0.6.8 (B2): the PRIMARY's SELF_FENCE_VOTE_LAG_SLOTS (its egress-only self-fence band). MUST match the
# value set on the PRIMARY. Startup asserts VOTE_LIVENESS_EPSILON <= this/4 (EPSILON << band) so a holder
# still landing votes inside its own self-fence band is always seen here as "voting" → BLOCK — the
# coupling that keeps the wedged-but-alive case safe (Audit-1 B7). 0 = skip the assert (not recommended).
EXPECTED_PRIMARY_VOTE_LAG_SLOTS=32

# v0.6.3 (Block 1): vote-liveness is REQUIRED. With VOTE_LIVENESS_VERIFY=false the daemon refuses
# to start AND will not take over, UNLESS you explicitly accept an UNFENCED takeover here — there
# is then NO split-brain fence at all (double-sign risk). Leave false.
ALLOW_UNFENCED_TAKEOVER=false

# v0.6.6 (N1): cross-node fail-over timing safety. The PRIMARY must RELINQUISH the staked identity
# (its self-fence) BEFORE this spare can take it, or both hold staked across a partition heal →
# double-sign. This script can't read the PRIMARY's config, so it WARNS loudly at startup (+ Telegram)
# when TAKEOVER_DELAY < EXPECTED_PRIMARY_SELF_FENCE_SECS + SELF_FENCE_MARGIN_SECS. Keep these in sync
# with the PRIMARY: EXPECTED = the PRIMARY's WORST-case self-fence timer (the larger of its
# SELF_FENCE_ISOLATION_SECS / SELF_FENCE_NOANSWER_SECS — both 30 by default in v0.6.6). Hard rule:
#   TAKEOVER_DELAY (STANDBY) >= EXPECTED_PRIMARY_SELF_FENCE_SECS + SELF_FENCE_MARGIN_SECS  (= 60 default)
#   BACKUP TAKEOVER_DELAY    >  STANDBY TAKEOVER_DELAY + VOTE_LIVENESS_MIN_INTERVAL + propagation
# If you raise the PRIMARY's SELF_FENCE_NOANSWER_SECS (e.g. testnet shows the local RPC stalls ≥30s),
# raise EXPECTED_PRIMARY_SELF_FENCE_SECS and TAKEOVER_DELAY here to match.
# Cross-node safety floor: a spare waits TAKEOVER_DELAY >= floor (holder's worst-case self-fence +
# margin) so the holder has stepped down before this spare may take.
# EXPECTED must MATCH the PRIMARY's self-fence worst-case — derive it from the PRIMARY config; do not tune independently.
# v0.6.9 (B2): ROLE-AWARE floor. FAILOVER_ROLE=STANDBY (first spare) → floor = EXPECTED + MARGIN.
# FAILOVER_ROLE=BACKUP (a later spare) → floor = max(120, STANDBY_TAKEOVER_DELAY + VOTE_LIVENESS_MIN_INTERVAL
# + MARGIN): a BACKUP must ALSO outwait the STANDBY's take becoming externally visible, else two spares
# can take before the first's votes surface → DOUBLE-SIGN. The wizard writes this; do NOT hand-edit.
FAILOVER_ROLE=STANDBY                      # STANDBY (first spare) | BACKUP (later spare); sets the cross-node timing floor
EXPECTED_PRIMARY_SELF_FENCE_SECS=30       # PRIMARY self-fence worst case (its larger self-fence timer)
SELF_FENCE_MARGIN_SECS=30                 # cross-node safety margin (loop + set-identity + clock skew + headroom)
# v0.6.9 (M9): a violation of TAKEOVER_DELAY >= EXPECTED + MARGIN is now FATAL at startup (was a
# warning). EXPECTED is an operator-typed claim with no runtime verification, so this one guard must
# bite. ALLOW_UNSAFE_TIMING=true restores warn-and-continue — for LAB/TESTING ONLY (double-sign risk
# on heal); never set it on a production spare. Mirrors the ALLOW_UNFENCED double-opt-in pattern.
ALLOW_UNSAFE_TIMING=false

# --- v0.6.8 (Option A): gossip identity-flip fast-path (ADDITIVE; OFF by default; fail-closed) ---
# During the countdown, if this node POSITIVELY observes the holder's node advertising its KNOWN unstaked
# identity in gossip (it self-fenced) — corroborated on BOTH external RPCs, after first seeing it absent —
# it SKIPS the remaining TAKEOVER_DELAY and proceeds to the SAME authoritative gates (external-confirm +
# vote-liveness==frozen). The flip skips ONLY the timer; it NEVER bypasses a gate. Helps graceful / no-answer
# / planned failovers (~85→~30-40s); does NOT help crash / egress-only (no flip reaches us → timer governs).
# Keys on the UNSTAKED pubkey APPEARING (its ~15s CRDS TTL ⇒ provably recent), NEVER on the staked entry
# vanishing (it lingers ~48h). REQUIRES: all staked-capable peers run RECOVERY_MODE=manual (no auto re-stake);
# two external RPC vantage points (TIER2 + TIER3).
WITNESS_FASTPATH=false                     # master switch; false = pure v0.6.7 timer behavior
PRIMARY_UNSTAKED_PUBKEY=""                 # space-separated holder unstaked pubkey(s) to watch; empty ⇒ disabled (fail-closed). MUST NOT be the staked pubkey.
FASTPATH_CONFIRM_SAMPLES=2                 # consecutive corroborated cycles before firing (stability)
FASTPATH_STAGGER_SECS=0                    # extra per-node stagger floor (usually 0 — the node COMPUTES the required floor from STANDBY_TAKEOVER_DELAY below). The effective floor is max(this, TAKEOVER_DELAY - STANDBY_TAKEOVER_DELAY).
FASTPATH_PEER_RECOVERY_MANUAL=false        # affirm all staked-capable peers run RECOVERY_MODE=manual. Fail-closed: the fast-path never fires unless true.
# v0.6.8 (S1): the FIRST spare's (STANDBY's) TAKEOVER_DELAY. Set the SAME on EVERY spare = the STANDBY's
# TAKEOVER_DELAY (on STANDBY: its own; on BACKUP: the STANDBY's smaller value). The node enforces an
# effective stagger = max(FASTPATH_STAGGER_SECS, TAKEOVER_DELAY - STANDBY_TAKEOVER_DELAY), so a BACKUP
# cannot fast-take ahead of the STANDBY. Empty / non-numeric / > this node's TAKEOVER_DELAY ⇒ fast-path
# DISABLED (fail-closed). Required whenever WITNESS_FASTPATH=true.
STANDBY_TAKEOVER_DELAY=""
# v0.6.8 (F-B): explicit FIRST-spare role. A zero stagger floor (STANDBY_TAKEOVER_DELAY >= TAKEOVER_DELAY)
# = fast-take with no delay relative to the STANDBY — correct ONLY for the one first spare. Set true ONLY on
# the STANDBY; keep false on every BACKUP. A zero floor without this true ⇒ fast-path DISABLED (fail-closed),
# so a BACKUP that mistakenly sets STANDBY_TAKEOVER_DELAY = its own delay cannot silently race the STANDBY.
WITNESS_FASTPATH_FIRST_SPARE=false

# v0.6.5 (F3): ALLOW_TAKEOVER_WHEN_EXTERNAL_RPC_DOWN was REMOVED (deprecated/ineffective). When both
# external RPCs are down, takeover always HOLDs — the authoritative vote-liveness fence also needs
# T2/T3 to sample lastVote, so a both-externals-down "emergency" takeover blocked regardless. The one
# explicit emergency local-only takeover is ALLOW_UNFENCED_TAKEOVER=true with VOTE_LIVENESS_VERIFY=false
# above (which removes the split-brain fence entirely — use only if you accept the double-sign risk).

# --- Telegram ---
TG_ENABLED=true
TG_BOT_TOKEN=""                           # format: "BOTID:BOTKEY"
TG_CHAT_ID=""

# --- Webhook (ntfy.sh auto-detected by URL; for Slack/Discord use WEBHOOK_BODY) ---
WEBHOOK_URL=""                            # e.g. "https://ntfy.sh/my-validators"
WEBHOOK_BODY=""                           # leave empty for ntfy; custom JSON for Slack/Discord

# --- External heartbeat watchdog (v0.6.4, "dead-man's switch") ---
# Fire-and-forget ping the monitor sends each loop. Point it at an ALERT-ON-ABSENCE service
# (healthchecks.io, Uptime-Kuma push, cronitor, or ntfy) configured to alert if NO ping arrives
# within ~2x HEARTBEAT_PING_INTERVAL — that catches a crashed monitor / dead host / dropped network
# that the Telegram/ntfy event alerts cannot. Empty = OFF. Use a DISTINCT URL per node
# (PRIMARY / STANDBY / BACKUP) so you know which monitor went silent.
HEARTBEAT_URL=""                          # e.g. "https://hc-ping.com/<uuid>" (this node only)
HEARTBEAT_PING_INTERVAL=""                # ping cadence (s); empty → defaults to HEARTBEAT_INTERVAL
