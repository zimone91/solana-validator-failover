# ============================================================================
# Solana PRIMARY Node Failover v0.7.0-rc2 (LOCAL-first, 3-Tier RPC)
#
# Normal cycle: 100% LOCAL RPC. T2/T3 only for confirmation on trigger.
#
# v0.7 ALPENGLOW MODE (always on): this node never takes the staked identity automatically - the PRIMARY has no armed take (a STANDBY takes it only
# when it is armed with AG_ARMED_TAKE=true in its own env file: docs/SAFETY.md, "Armed cold take"). The take-side settings below (TAKEOVER_DELAY, the
# fences, the proof-gate and fast-path knobs, RECOVERY_MODE=rpc) size the RETAINED take path, which v0.7 never runs: a take every gate approves is
# WITHHELD and paged instead (docs/SAFETY.md, Alpenglow). The holder's self-fence and the monitoring stay as they were; HOLDER_GAP_DEMOTE_SECS
# (below) is this holder's half of an armed pair.
# Edit all values below before first run.
# After changes: systemctl restart solana-failover
#
# SECURITY: once filled this file holds secrets (TG_BOT_TOKEN, the paid-RPC key
# inside TIER2_RPC, WEBHOOK_URL). The deploy script chmod 600's it. Never commit a
# filled copy to git — the repo ships only this placeholder template.
# ============================================================================

# --- Node identity ---
NODE_NAME="MY_VALIDATOR"                  # shown in Telegram/ntfy alerts
VALIDATOR_TYPE="agave"                    # "agave" or "frankendancer"

# --- Keypair paths ---
STAKED_KEYPAIR="/root/solana/mainnet-validator-keypair.json"
UNSTAKED_KEYPAIR="/root/solana/unstaked-identity.json"
# UNSTAKED_PUBKEY (v0.7 `failover arm`): the pubkey the validator unit must restart on — the
# arm ceremony derives the pubkey of the key file actually AT the unit's --identity path and
# refuses the REAL arm unless it equals this declared value (a symlink or mis-copied staked
# key at the right path is the double-sign hole this closes). Derive it with:
#   "$SOLANA_PATH"/solana-keygen pubkey "$UNSTAKED_KEYPAIR"
# Unset ⇒ the real arm refuses as UNVERIFIABLE (page-only arm never needs it).
#UNSTAKED_PUBKEY=""
SOLANA_PATH="$HOME/.local/share/solana/install/active_release/bin"
LEDGER_PATH=""                            # empty = auto-detect from running validator / systemd (the daemons only: the fence does NOT auto-detect - fill it before `failover arm`, which refuses a real arm with it empty; the deploy script writes it when it detects it)
VALIDATOR_SERVICE="solana"                # systemd unit name (only used as ledger auto-detect fallback)

# --- Three-Tier RPC ---
LOCAL_RPC="http://127.0.0.1:8899"                                             # LOCAL: delinquency check (every cycle, free)
TIER2_RPC="https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE"             # Tier 2: confirm only on trigger (saves CU)
TIER3_RPC="https://api.mainnet-beta.solana.com"                                # Tier 3: fallback confirmation

# --- Thresholds ---
CHECK_INTERVAL=3                          # seconds between Tier 1 checks (normal)
TURBO_INTERVAL=1                          # seconds between checks (turbo: when delinquency detected)
# v0.7 (rc2 F22): failed Internet rounds before the Internet-lost demote. One round = CHECK_INTERVAL + the fixed 1.5 s wait for the pings + the 1 s curl fallback (CONNECTIVITY_TIMEOUT does not change it)
# = about 5.5 s measured on the pair, so 6 = about 33 s; keep CONNECTIVITY_RETRIES x (CHECK_INTERVAL + 2) >= SELF_FENCE_ISOLATION_SECS (30): the isolation rung is the intended floor, and a shorter
# Internet rule demotes the holder on a WAN hiccup (3 rounds: a 20 s egress blip demoted it at +17 s, the spare took at +69 s). With the self-fence on, the daemon warns [config-drift] at startup when it is set below that floor.
CONNECTIVITY_RETRIES=6                    # failed rounds before the Internet-lost demote: 6 x 5.5 s = about 33 s (must stay >= SELF_FENCE_ISOLATION_SECS)
DELINQUENCY_RETRIES=5                     # used for vote latency counter; delinquency uses sliding window (7/10)
MAX_VOTE_LATENCY=0                        # 0 = delinquency only; >0 = switch if N slots behind
# v0.7 (Block 6.3.1, S8 — fixed): when >0, tier1_get_vote_latency reads its getVoteAccounts PAYLOAD FIRST,
# then its getSlot reference, so a stall/pet between the two (up to 27s: both reads at their curl -m 10
# bound + a 7s pet) can only make the holder look LESS current — the demote comes sooner, never later (6.3
# read the reference first and could delay the demote by a full STAKED loop cycle). The price: a live
# holder whose two reads straddle a long stall reads over-limit on that cycle — a demote still needs
# DELINQUENCY_RETRIES consecutive over-limit reads and TIER2's own latency verdict (availability, opt-in).
# This path is NOT part of the cross-node invariant: it may fire after a spare's take — the relinquish
# bound B covers the self-fence only (whose own-vote-lag check reads one same-payload snapshot).

# --- Sliding window (DDoS protection) ---
DELINQUENCY_WINDOW_SIZE=10                # last N checks to consider
DELINQUENCY_WINDOW_THRESHOLD=7            # how many must be delinquent to trigger
HEARTBEAT_INTERVAL=600                    # status log every N seconds (600 = 10 min)

# --- Safety ---
# Phase 1-2: DRY_RUN=true,  RECOVERY_MODE="manual"
# Phase 3:   DRY_RUN=false, RECOVERY_MODE="manual"
# Phase 4+ (optional, advanced): RECOVERY_MODE="rpc" — NOT recommended; "manual" is the safer
#            default the daemon assumes (auto re-take adds risk exactly when things are broken).
DRY_RUN=true
RECOVERY_MODE="manual"                    # "manual" | "auto" | "rpc"

# --- Recovery (RECOVERY_MODE="rpc") + N6 self-fence ---
# Get vote pubkey: solana-keygen pubkey /root/solana/vote-account-keypair.json
# v0.6.7 (N7): VOTE_PUBKEY is now REQUIRED whenever the N6 egress-only self-fence is on (the shipped
# default — SELF_FENCE_VOTE_LAG_SLOTS/SECS > 0 below), not just for RECOVERY_MODE=rpc. The daemon REFUSES
# to start with this blank while N6 is armed (it reads our own vote account's lastVote). Set it, or set
# SELF_FENCE_VOTE_LAG_SLOTS=0 to disable N6 (not recommended — re-opens the egress-only double-sign hole).
VOTE_PUBKEY=""
RECOVERY_DELAY=300                        # seconds to wait after switch before recovery attempt
RECOVERY_CHECKS=3                         # consecutive "safe" confirmations needed
RECOVERY_CHECK_INTERVAL=30                # seconds between recovery checks
# v0.7: the rpc re-take passes only in a band of the account's age (the own-view veto), and at any cluster
# rate, depending on phase (measured at 1.0 and 2.5 slots/s), it may never complete — QUIETLY: the daemon
# logs the held pass at INFO and stays unstaked, with at most the veto's own throttled page (docs/SAFETY.md,
# the own view's costs). After a failover an rpc-mode PRIMARY sends no page at all (its own node sees the
# STANDBY voting); the STANDBY's TOOK STAKED page is the signal. Watch for it and switch back manually;
# "manual" (the default) is unaffected.

# v0.6.3 (Block 2): rpc-recovery vote-liveness fence. PRIMARY re-takes the staked identity ONLY
# if nobody is voting it (lastVote frozen over the interval, external cluster tip advancing).
# Only consulted in RECOVERY_MODE="rpc". 'manual' (operator switch-back) stays the safer default.
# v0.7 (A3): EPSILON 2 → 0 — ANY forward lastVote movement counts as "voting". ε=0 presumes the
# provider-pinned sample pair; do NOT raise it to mask provider flapping — fix the provider.
VOTE_LIVENESS_EPSILON=0                    # lastVote must advance > N slots to count as "voting" (0 = ANY advance)
VOTE_LIVENESS_MIN_INTERVAL=10             # min seconds between the two lastVote samples
VOTE_LIVENESS_MIN_SPAN=40                 # frozen re-take needs >= this many seconds of OBSERVED span since the
                                          # EPISODE's first successful observation (or the end of the last
                                          # blind cycle) (0 = disabled). Enforces "zero votes for the ENTIRE
                                          # delay" on late-observed episodes; converges under provider-flip
                                          # storms (pair re-bases never restart the span) — fails toward NOT
                                          # re-taking (adds ~30s before an automatic rpc-mode re-take).

# --- PRIMARY self-fence / "vote lease" (v0.6.3 Block 3) ---
# If this STAKED node is isolated from the supermajority (partition / severe DDoS), its LOCAL
# confirmed slot stops advancing. The self-fence then drops it to UNSTAKED *during* the partition
# (LOCAL signals only) so it stops voting before a heal can double-sign. It can only ever switch to
# unstaked (the safe direction). Set PRIMARY_SELF_FENCE=false to disable.
PRIMARY_SELF_FENCE=true                    # master kill switch
# 30s: PRIMARY drops the staked identity within ~30s of going silent so a spare can take over safely (the retained path; in v0.7 the spare pages and you swap).
# Do NOT raise without raising every spare's EXPECTED_PRIMARY_SELF_FENCE_SECS and TAKEOVER_DELAY by the
# same amount (else the cross-node margin is lost → double-sign).
SELF_FENCE_ISOLATION_SECS=30              # LOCAL getSlot(confirmed) must advance within this window
SELF_FENCE_MAX_BEHIND=150                 # optional LOCAL getHealth "behind by >N" demote (0 = off)
# v0.6.5 (F1): demote if LOCAL getSlot(confirmed) is CONTINUOUSLY no-answer this many seconds while
# staked AND a baseline already exists (never on a fresh start). Closes the silent-LOCAL-RPC isolation
# case (node looks staked-but-fine to the admin RPC while STANDBY could take over → heal double-sign).
# v0.6.6 (N1): default 60 → 30 so the PRIMARY relinquishes (self-fence worst case 30s) well before any
# spare's TAKEOVER_DELAY (60). Fail-safe (→ UNSTAKED), so an over-eager value costs availability, not a
# double-sign. 30s is more false-fire-prone than 60s — MEASURE local JSON-RPC stall frequency on testnet
# and raise this AND the spare's TAKEOVER_DELAY together if your hardware stalls the RPC ≥30s under load.
# Do NOT raise without raising every spare's EXPECTED_PRIMARY_SELF_FENCE_SECS and TAKEOVER_DELAY by the
# same amount (else the cross-node margin is lost → double-sign).
SELF_FENCE_NOANSWER_SECS=30               # 0 = disable this sub-check
# v0.6.7 (N6): egress-only self-fence — "can I BE HEARD?" The checks above only catch "can I HEAR the
# cluster?" (inbound). If we still RECEIVE blocks but our OWN votes stop landing (egress-only partition),
# the confirmed slot keeps advancing and getHealth reads fine, so they stay blind. Demote when our own
# vote account (VOTE_PUBKEY) lastVote lags the same-payload cluster-max lastVote (one LOCAL
# getVoteAccounts at commitment=processed — v0.6.7 N8) by > SELF_FENCE_VOTE_LAG_SLOTS for
# >= SELF_FENCE_VOTE_LAG_SECS. LOCAL signal only; safe direction only. Sizing is cross-node margin (NOT
# just false-fire): the lag grows at the slot rate, so demote ≈ SLOTS/rate + SECS ≈ 33s at 32 slots at the
# ASSUMED 2.5 slots/s (mainnet MEASURED ≈3.7 slots/s on 2026-09-26: ≈29s — sooner, the safe side) —
# before a worst-case fast spare (~68s) so the PRIMARY relinquishes first. Keep in 24–48 (the healthy
# soak calibrates it); too high re-opens the egress-only race. Either knob = 0 disables this sub-check.
SELF_FENCE_VOTE_LAG_SLOTS=32              # own-vote lag (slots) past the cluster-max lastVote before counting as "not landing"
SELF_FENCE_VOTE_LAG_SECS=20              # sustained seconds over threshold before demoting (0 = disable)
# v0.6.8 (B2): N6 flap hysteresis — consecutive healthy cycles before the sustain timer is cleared. Stops
# a flapping/intermittent egress (one vote burst per < SECS) from re-zeroing the timer so N6 never fires
# (the wedged-but-alive hole). >= 2 (1/0 = no hysteresis); 3 is the conservative default.
SELF_FENCE_VOTE_LAG_RESET_CYCLES=3

# v0.7 (AG-3.4): the holder's GAP RULE. A frozen host (VM pause, live migration, suspend) resumes the validator and this
# monitor together: when the time since the END of the monitor's previous cycle is >= this many seconds while the node holds
# the STAKED identity, a spare may have taken it during the freeze, so the holder demotes FIRST - right after that cycle's identity read, before check_internet and the self-fence.
# Always on for a holder; a restarted monitor has no stamp, so a restart is not a gap. Floor 20 (and 17 + the longer of
# CHECK_INTERVAL / TURBO_INTERVAL). PAIRING RULE - this daemon cannot read the spare's env: the spare's TAKEOVER_DELAY must be
# >= HOLDER_GAP_DEMOTE_SECS + 30 (the shipped pair: 60 >= 30 + 30). Raise the one, raise the other.
HOLDER_GAP_DEMOTE_SECS=30

# v0.7 (AG-3.8): the HUNG HOLDER'S RUNG. A validator that is alive but mute (SIGSTOP, a deadlock) keeps the staked identity and
# answers nothing, so the demote and the self-fence cannot run. When its identity has been unreadable for this many seconds while the
# node was last seen STAKED, and it is still the same process, LOCAL getSlot is silent and the vote account's lastVote (read from
# TIER2_RPC, then TIER3_RPC) is NOT growing, this daemon hard-stops it (SELF_FENCE_HARD_STOP=true). A process in state T (stopped) or
# D (uninterruptible sleep) cannot handle SIGTERM: the ladder then skips the blocking `systemctl stop`, asks systemd for the stop without
# waiting (`systemctl stop --no-block`: a requested stop, so Restart= does not apply to the kill), SIGKILLs at once and verifies; any other
# state takes the normal ladder (systemctl stop first). Anything else - an external read that fails, lastVote
# growing, a local RPC that answers, a validator that restarted (since the last readable read, or during the episode) - is only a page: a voting validator is never stopped. DRY_RUN=true pages
# what it would stop. Floor 20; needs VOTE_PUBKEY. Unreadable cycles are 11 s apart and the first one also takes a baseline read of the vote account (about 1 s),
# so the rung's clock reads 0, 12, 23, 34 s and it acts on the first reading at or after this many seconds: 30 is the fourth (34 s after the first unreadable
# cycle), 22 would be the third (23 s; so would any value from 13 to 23). From the hang the validator is dead 48 to 51 s later on the fast branch, 70 to 73 s on the
# normal ladder when `systemctl stop` is wedged for its whole bound (50 to 53 s when it returns after 2 s); the spare's earliest take (TAKEOVER_DELAY 60 from the
# anchor, plus the gates, at MAX_DELINQUENT_SLOTS 15) is 73 s after the last vote at 3.7 slots/s and 79 s at 2.5 (104 / 125 s at 0), the
# readiness margin aside (it can only hold a take later); not re-derived for the Alpenglow rate. Raise the one, raise the other.
HOLDER_UNREACHABLE_STOP_SECS=30

# v0.7 (rc2 F21): the SILENT STAKE. While this node is UNSTAKED (a demoted holder, or any restart: every node starts unstaked) it reads the staked vote account's public lastVote from
# TIER2_RPC, then TIER3_RPC (one read per VOTE_LIVENESS_MIN_INTERVAL) and pages `STAKED IDENTITY SILENT` when it has not moved for this many seconds while the cluster tip did:
# nobody is voting the staked identity (the spare's host is dead, or its validator is down). Monitor-only - it acts on nothing, in any RECOVERY_MODE and in DRY_RUN, and this node
# never takes the staked identity in Alpenglow mode, so the page is all FO can give. The first page comes when the span is reached, repeats follow ALERT_THROTTLE while the silence
# lasts, one INFO line in the log says when the votes resume. No answer from either provider, a view whose tip does not advance past the previous read and a change of provider are no evidence: no page.
# Needs VOTE_PUBKEY (off without it). Floor 30. PAIRING RULE - this daemon cannot read the spare's env: keep it >= the spare's TAKEOVER_DELAY + 30 (the shipped pair: 90 >= 60 + 30),
# or an armed spare's ordinary take (73 to 79 s after the holder's last vote at MAX_DELINQUENT_SLOTS 15, about 3 s later at the v0.7 wizard's 24) pages; a value other than 90 is announced at start. Raise the one, raise the other.
SILENT_STAKE_PAGE_SECS=90

# v0.6.8 (B1): bound the demote/promote set-identity admin-socket calls (same socket get_local_identity
# wraps in timeout 8 — "can hang under load/compaction"). An un-timeout'd demote could freeze the loop
# mid-demote and silently re-open the double-sign gap. >= 8. On a DEMOTE timeout, escalate (below).
SETIDENTITY_TIMEOUT=15
# v0.6.8 (B1): when a DEMOTE wedges, hard-stop the validator (systemctl stop, then SIGTERM) so the staked
# identity provably stops voting (a stopped validator cannot double-sign). false = alert only, do NOT stop
# (NOT recommended — re-opens the gap). Never triggers in DRY_RUN or on the recovery/promote path.
SELF_FENCE_HARD_STOP=true
# v0.6.9 (H2): a hard-stop must survive Restart=always: the down-state is RE-verified after this many
# seconds (>= your unit's RestartSec, typically 10). A resurrected validator = HARD STOP FAILED page (never
# a false ✅). The unit is NOT masked (v0.6.9 masked it with `mask --runtime`; a runtime mask is shadowed by a
# unit file under /etc/systemd/system): the stop is a requested `systemctl stop`, which Restart= does not undo.
# Recovery after a hard stop: `systemctl start solana` (boots on the UNSTAKED identity; the ✅ page names it).
HARD_STOP_REVERIFY_SECS=15
# v0.7 (rc1 F19): after the SIGKILL the ladder polls the validator once per second for up to this many seconds (floor 1) until the process is GONE, and calls the stop FAILED only if it
# is still there at the bound: a validator with a large resident set needs seconds to be torn down (~2.4 s measured for ~150 GB), which the old single read 1 s after the kill took for
# a failed stop. The re-verify above then runs exactly as before.
HARD_STOP_EXIT_WAIT_SECS=15

# --- Collision detector (v0.6.9 M5) ---
# While STAKED, every COLLISION_CHECK_INTERVAL seconds compare where external gossip (T2/T3) says the
# staked pubkey lives against our OWN endpoint (LOCAL view). Two consecutive mismatches → 🚨 page
# "STAKED IDENTITY SEEN ELSEWHERE (possible collision)" (throttled by ALERT_THROTTLE). DETECTION-ONLY:
# it never demotes (deciding the loser under a real collision is the operator's call — see the manual's
# "Emergency: Split-Brain"; an auto-demote keyed on ~48h-lingering, flapping gossip would be a
# false-positive availability hazard).
COLLISION_CHECK_INTERVAL=60

# --- State persistence (v0.6.9 H3/M10) ---
# The state file is role-specific (.../state-primary) so colocated daemons can't clobber each other; a
# legacy .../state file is migrated once at startup. The self-fence baseline (frozen-slot / no-answer /
# vote-lag clocks) is persisted every cycle and restored after a monitor restart ONLY when the save is
# fresher than STATE_MAX_AGE_SECS — and the stall clocks are inherited only on first-read evidence the
# stall is CONTINUOUS (a recovered validator clears instantly; a stale save restores nothing).
STATE_MAX_AGE_SECS=900
# If the persisted state says this node was STAKED and the local validator is unreachable for this many
# seconds at monitor startup, page 🚨 PRIMARY UNREACHABLE WHILE STAKED (once) — the daemon cannot
# demote an unreachable validator (in Alpenglow mode no spare takes the identity by itself unless it is armed - AG_ARMED_TAKE=true in the spare's env: by default it stays here until an operator moves it).
STARTUP_STAKED_UNREACHABLE_ALERT_SECS=60

# --- Telegram ---
TG_ENABLED=true
TG_BOT_TOKEN=""                           # format: "BOTID:BOTKEY"
TG_CHAT_ID=""

# --- Webhook (ntfy.sh auto-detected by URL; for Slack/Discord use WEBHOOK_BODY) ---
WEBHOOK_URL=""                            # e.g. "https://ntfy.sh/my-validators"
WEBHOOK_BODY=""                           # leave empty for ntfy; custom JSON for Slack/Discord

# --- External heartbeat watchdog (v0.6.4, "dead-man's switch") ---
# Fire-and-forget ping the monitor sends each loop. Point it at an ALERT-ON-ABSENCE service
# (healthchecks.io, Uptime-Kuma push, cronitor, or ntfy) configured to alert if NO ping arrives
# within ~2x HEARTBEAT_PING_INTERVAL — that catches a crashed monitor / dead host / dropped network
# that the Telegram/ntfy event alerts cannot. Empty = OFF. Use a DISTINCT URL per node
# (PRIMARY / STANDBY / BACKUP) so you know which monitor went silent.
HEARTBEAT_URL=""                          # e.g. "https://hc-ping.com/<uuid>" (this node only)
HEARTBEAT_PING_INTERVAL=""                # ping cadence (s); empty → defaults to HEARTBEAT_INTERVAL

# --- Alpenglow feature-gate tripwire (v0.7 AG-1.1; report only) ---
ALPENGLOW_GATE_CHECK_HOURS=6              # read the on-chain alpenglow feature account every N hours; page ONCE per run when it reads pending/absent or leaves active (the RPC may not serve your cluster). AG mode does not depend on it (0 = off)

# --- Validator version minimum (v0.7 AG-1.5) ---
MIN_VALIDATOR_VERSION=4.4.0               # the lowest validator version the AG page calls ready: a semantic version, read from LOCAL_RPC getVersion (solana-core); a pre-release orders before its release. A lower value is drift-announced
