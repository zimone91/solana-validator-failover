# SKELETON (v0.7 Block 5) — installed ONLY by the `failover arm` ceremony (not yet shipped);
# NOTHING in this repository installs units. The Block-5 entry blocker (all four nodes on
# v0.6.10+) gates the first real installation.
#
# The monitor under the NATIVE systemd watchdog (DESIGN-v0.7-ADDENDUM §2.2/§2.6 +
# design-records/research-systemd-watchdog.md). It replaces nothing today: the shipped v0.6.x
# unit (solana-failover.service — Type=simple, Restart=always, no watchdog) keeps running
# everywhere until `failover arm` performs the switch on a host that passed the entry blocker.
#
# WIRING CHOICE (per the Block-5 spec, justified): OnFailure= lists BOTH fence units as PLAIN
# units — no @-template (the fence needs no instance parameter; %n would only decorate page
# text). This keeps the monitor unit IMMUTABLE across arm states: `failover arm` never edits it,
# so arm-state lives ENTIRELY in which fence unit file exists (§2.3: arm-state IS which of the
# two fence units is installed — one source of truth, byte-aligned with the daemons'
# _fence_unit_state classifier). ✅ VERIFIED BY EXECUTION (2026-08-20, real-systemd containers,
# systemd 249 AND 255 — the fleet's boundary versions; design record
# verify-onfailure-missing-unit.md): systemd enqueues each OnFailure= job independently and
# ignores a listed unit that is not installed — journal: "Failed to enqueue OnFailure= job,
# ignoring: Unit … not found"; the failing unit still reaches terminal `failed`, and the
# EXISTING unit in the list dispatches despite the missing sibling. Load-bearing in ANY design
# (every un-armed host names a nonexistent unit) — which is why it was executed, not reasoned
# (the gate-B class). The §2.1-rev2.1 arm-time probe still physically demonstrates the dispatch
# on THIS host before any armed state exists — the record proves the semantics, the probe proves
# the wiring live. BOTH fence units present is an arm-ceremony
# bug state: the daemons classify it as `real` (fail toward the №1 refusal), and the real
# fence's outcome dominates (the page-only unit mutates nothing by construction).

[Unit]
Description=Solana failover monitor (v0.7, native-watchdog fenced)
Documentation=https://github.com/zimone91/solana-validator-failover
After=network-online.target
# R8 (research record, assumption 2 — THE sharp edge): OnFailure= fires ONLY on the terminal
# `failed` state. With ANY restarting Restart= the unit cycles active→activating and NEVER
# reaches `failed` until the start limit is exhausted (systemd #34023/#27594) — the fence would
# simply never run. The pair Restart=no (below) + StartLimitIntervalSec=0 is THE load-bearing
# difference from a naive unit: the FIRST missed pet drives this unit to `failed` and
# dispatches the fence, deterministically, in one hop.
OnFailure=solana-failover-fence.service solana-failover-fence-page-only.service
StartLimitIntervalSec=0

[Service]
# §2.6 (rev3/№6): Type=notify + the daemon writing sd_notify datagrams to $NOTIFY_SOCKET via
# socat — the SOLE armed transport in v0.7 (no C shim, no systemd-notify in armed mode; the
# research record's chosen pattern, assumption 1). HONESTY FIX (Block 5.2): socat is
# unavoidably a forked CHILD of the daemon, so the datagram's SCM_CREDENTIALS are socat's own,
# NOT the main PID's — the pre-257 fork-and-exit attribution race applies to it as an auxiliary
# process (sd_notify(3): the pidfd/MAINPIDFD= fix is "Added in version 257"; every current
# target ships 249–255). Therefore NotifyAccess=all — PID 1 must accept datagrams from the
# unit's auxiliary processes at all — and every payload carries the MainPID claim (MAINPID=$$,
# the daemon's own PID; see the daemons' _sd_notify). Honest residual: a datagram whose sender
# already exited can still be discarded (the record's race note) — absorbed by the pet cadence
# (WatchdogSec=30 vs the ≤ ~22 s worst-case inter-pet gap derived at _watchdog_pet), never by
# retry. On systemd >= 257 systemd-notify becomes a full zero-dependency transport and
# `failover arm` may prefer it there — referenced only, not implemented in v0.7.
Type=notify
NotifyAccess=all
# BLOCK5-PROPER: `failover arm` writes the role's daemon here (solana-primary-failover.sh or
# solana-standby-failover.sh) — the skeleton deliberately does not guess a role, and the
# <role> placeholder keeps this file uninstallable as-is.
ExecStart=/opt/solana-failover/solana-<role>-failover.sh
EnvironmentFile=/opt/solana-failover/failover.env
# §2 derivation (addendum §3a.3: timing constants live in ONE derivation table, never scattered):
# 30 s vs the daemons' per-op pet cadence — the honest figure (Block 5.2 fix round, aligned to
# the derivation at _watchdog_pet): worst-case inter-pet gap ≈ 22 s (the single longest bounded
# op, SETIDENTITY_TIMEOUT 15 + kill-grace 5, + glue) < 30 at ZERO datagram loss. NOT "tolerates
# one lost datagram at a ~10–15 s cadence": across a maximal 20 s op the gap exceeds
# WatchdogSec/2, so ONE discarded datagram immediately before such an op is the daemons' NAMED
# false-fence residual (the kernel-local discard class, not network loss). 30 s also stays
# inside every cross-node bound the spare's timers assume. R15: WatchdogSec is enforced by
# PID 1 on CLOCK_MONOTONIC — immune by construction to the NTP-step class that defeated the old
# wall-clock fence (AUDIT-5). Shortening it is a false-fire-rate trade, gated on the measured
# E2E rate (§3.4) — never asserted.
WatchdogSec=30
# §2.2 (BLOCKER-2, rev-2 — the reboot-brick fix): the daemon sends READY=1 ONLY after its first
# successful identity read; pre-READY the watchdog is unarmed and the daemon extends startup
# honestly, sending EXTEND_TIMEOUT_USEC each cycle WHILE it can positively confirm the
# validator is up in startup/replay (process alive + admin socket / health answering
# "starting"). A wedged monitor stops extending → timeout → fence; a long replay extends
# honestly. This replaces the rev-1 static TimeoutStartSec guess (a replay longer than the
# guess would have fenced a healthy validator mid-replay — the reboot brick with a 20-minute
# fuse). EXTEND_TIMEOUT_USEC is supported since systemd 236 — all targets.
#
# Pre-first-EXTEND bound (Block 5.2 fix round): the live extension governs only once the daemon
# has SENT an EXTEND — an iteration that cannot positively confirm startup sends NOTHING. From
# exec to the first extension decision the governing bound is TimeoutStartSec, pinned here to
# 90 s (= the systemd default, made EXPLICIT so the daemons' part-D scenario (b) bound is
# stated where it binds and survives a future default change). The daemons' pre-wait-loop
# startup work is bounded ≈ 30–40 s — comfortably inside. An EXTEND replaces the remaining
# start timeout, so steady evidence keeps extending and a long replay is never fenced by this.
TimeoutStartSec=90s
#
# R8 (load-bearing, see the [Unit] comment): NEVER a restarting policy on this unit. Post-fence
# restart of the monitor is the FENCE's explicit action (two marker states, §2.2), not PID 1's.
Restart=no
# Watchdog expiry sends SIGABRT (the default — explicit for audit; research record assumption
# 4). A bash monitor has nothing to core-dump: TimeoutAbortSec=5s SIGKILLs a SIGABRT-ignoring
# monitor fast so the unit settles into `failed` (and thus the fence) without delay. The daemon
# must NOT trap/ignore SIGABRT.
WatchdogSignal=SIGABRT
TimeoutAbortSec=5s
User=root
LimitNOFILE=1000000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solana-failover-monitor

[Install]
WantedBy=multi-user.target
